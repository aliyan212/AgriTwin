# AgriTwin AI — Backend Environment Configuration Example
# Copy this file to .env: cp .env.example .env

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="AgriTwin AI"
APP_VERSION="0.1.0"
DEBUG=True
API_PREFIX="/api/v1"

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (Default for quick local development):
DATABASE_URL="sqlite:///./agritwin.db"

# PostgreSQL + PostGIS (Docker / Production):
# DATABASE_URL="postgresql://agritwin:agritwin_dev@localhost:5432/agritwin"

# ── External AI & Telemetry ──────────────────────────────────────────────────
# Google Gemini API Key (for LLM agronomic copilot recommendations)
# If omitted, AgriCore automatically uses Punjab agricultural rule-based reasoning.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# ── Security & Authentication ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY="change-me-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Sentinel Hub (Optional 10m Satellite Zoning) ─────────────────────────────
SENTINEL_HUB_CLIENT_ID=""
SENTINEL_HUB_CLIENT_SECRET=""

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'
